# Copy to .env (and NEVER commit the real .env) — docker-compose / IntelliJ EnvFile plugin can load this


SERVER_PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/user_db
DB_USERNAME=user_service
DB_PASSWORD=password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# --- NATS ---
NATS_URL=nats://localhost:4222
NATS_USERNAME=user_service
NATS_PASSWORD=password
NATS_CREDS_FILE=
NATS_TLS_ENABLED=false
NATS_TRUSTSTORE_PATH=
NATS_TRUSTSTORE_PASSWORD=
NATS_STREAM_NAME=USER_EVENTS
NATS_SUBJECT_PREFIX=user.events

OUTBOX_RELAY_DELAY_MS=2000
OUTBOX_MAX_ATTEMPTS=5

LOG_LEVEL=INFO
