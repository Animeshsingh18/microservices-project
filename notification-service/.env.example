# Copy to .env — never commit the real .env

SERVER_PORT=8082

DB_URL=jdbc:postgresql://localhost:5433/notification_db
DB_USERNAME=notification_service
DB_PASSWORD=password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

JWT_SECRET=

NOTIFICATION_CHANNEL=LOG
NOTIFICATION_FROM_ADDRESS=no-reply@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

NATS_URL=nats://localhost:4222
NATS_USERNAME=notification_service
NATS_PASSWORD=password
NATS_CREDS_FILE=
NATS_TLS_ENABLED=false
NATS_TRUSTSTORE_PATH=
NATS_TRUSTSTORE_PASSWORD=
NATS_STREAM_NAME=USER_EVENTS
NATS_SUBJECT_PREFIX=user.events
NATS_DURABLE_CONSUMER=notification-service-durable
NATS_MAX_DELIVER=5
NATS_ACK_WAIT_SECONDS=30
NATS_DLQ_SUBJECT=user.events.dlq

LOG_LEVEL=INFO
